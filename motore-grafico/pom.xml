<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.saturno14</groupId>
    <artifactId>motore-grafico</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <lwjgl.version>3.3.3</lwjgl.version>
        <!-- Cambia in natives-linux o natives-macos se non sei su Windows -->
        <lwjgl.natives>natives-windows</lwjgl.natives>
        <joml.version>1.10.5</joml.version>

        <!--
            Fisica rigida: jolt-jni e' il binding Java del motore Jolt (lo stesso usato da
            Horizon Forbidden West / Godot 4). Serve per la locomozione dei corpi articolati
            (src.body). Come LWJGL ha bisogno dei nativi della piattaforma: il jar senza
            classifier porta le classi Java, quello con classifier porta la libreria nativa
            (joltjni.dll). Su Linux/macOS cambia jolt.platform (Linux64, MacOSX64, MacOSX_ARM64).
            "ReleaseSp" = build ottimizzata, precisione singola (basta: le distanze in gioco
            sono metri, non chilometri).
        -->
        <jolt.version>6.2.0</jolt.version>
        <jolt.platform>Windows64</jolt.platform>
        <jolt.flavor>ReleaseSp</jolt.flavor>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.lwjgl</groupId>
                <artifactId>lwjgl-bom</artifactId>
                <version>${lwjgl.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl</artifactId>
            <classifier>${lwjgl.natives}</classifier>
        </dependency>

        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-glfw</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-glfw</artifactId>
            <classifier>${lwjgl.natives}</classifier>
        </dependency>

        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-opengl</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-opengl</artifactId>
            <classifier>${lwjgl.natives}</classifier>
        </dependency>

        <dependency>
            <groupId>org.joml</groupId>
            <artifactId>joml</artifactId>
            <version>${joml.version}</version>
        </dependency>

        <!-- Fisica rigida (vedi le proprieta' jolt.* sopra): classi Java + libreria nativa -->
        <dependency>
            <groupId>com.github.stephengold</groupId>
            <artifactId>jolt-jni-${jolt.platform}</artifactId>
            <version>${jolt.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.stephengold</groupId>
            <artifactId>jolt-jni-${jolt.platform}</artifactId>
            <version>${jolt.version}</version>
            <classifier>${jolt.flavor}</classifier>
        </dependency>

        <!-- GENETICS_SPEC.md punto 11: nessuna libreria JSON era presente nel progetto,
             aggiunta per GenomeSchema/Genome (caricamento e serializzazione JSON). -->
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20240303</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Compila solo i sorgenti Java presenti in questo modulo e in ../simulazione/
                (aggiunta sotto da build-helper-maven-plugin). Nessun exclude necessario:
                le vecchie copie duplicate sono state rimosse dal progetto.
                Usa <release> invece di source/target per evitare il warning sui system modules.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>

            <!--
                Aggiunge ../simulazione/ (cartella sorella, FUORI da motore-grafico/) come
                cartella sorgente aggiuntiva, cosi' Maven compila i file della simulazione
                (package "src", incluso il sotto-package "src.genetics" del genoma) insieme
                al motore grafico, LEGGENDOLI direttamente da dove stanno. I file della
                simulazione non vengono modificati dal motore grafico: ogni modifica a
                simulazione/src/*.java si riflette al prossimo mvn compile.
                In piu', add-resource espone simulazione/src/genetics/resources/ (dove vive
                gene_schema.json) sul classpath, cosi' il file resta fisicamente dentro la
                cartella della simulazione invece che in motore-grafico/src/main/resources/.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>add-simulation-source</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.basedir}/../simulazione</source>
                            </sources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>add-genetics-resource</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>add-resource</goal>
                        </goals>
                        <configuration>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../simulazione/src/genetics/resources</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <mainClass>com.saturno14.esit.graphics.Main</mainClass>
                    <!--
                        Java 25 avverte a ogni System.load di una libreria nativa (jolt-jni).
                        Il flag dichiara che l'accesso nativo e' voluto e togle l'avviso.
                    -->
                    <commandlineArgs>--enable-native-access=ALL-UNNAMED</commandlineArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
